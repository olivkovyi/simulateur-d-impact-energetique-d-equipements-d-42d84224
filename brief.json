    "document_html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Simulateur d&#x27;Impact Énergétique d&#x27;Équipements Domestiques | Votre Bilan Énergétique Personnalisé</title>\n    <meta name=\"description\" content=\"Calculez la consommation électrique estimée et l\">\n    <style>\n        :root {\n            --primary-green: #008000;\n            --secondary-yellow: #FFD700;\n            --background-light: #F0F8F0;\n            --text-dark: #333;\n            --text-light: #fff;\n            --border-color: #A9D18E;\n            --shadow-color: rgba(0, 0, 0, 0.1);\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        }\n\n        body {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n            background-color: var(--background-light);\n            color: var(--text-dark);\n            line-height: 1.6;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n\n        header {\n            width: 100%;\n            background: linear-gradient(135deg, var(--primary-green) 0%, #33B249 100%);\n            color: var(--text-light);\n            padding: 2rem 0;\n            text-align: center;\n            box-shadow: 0 4px 8px var(--shadow-color);\n        }\n\n        header h1 {\n            margin: 0;\n            font-size: 2.8rem;\n            letter-spacing: -0.05em;\n        }\n\n        header p {\n            font-size: 1.2rem;\n            opacity: 0.9;\n            max-width: 800px;\n            margin: 1rem auto 0;\n        }\n\n        .container {\n            width: 90%;\n            max-width: 1000px;\n            margin: 2rem auto;\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 2rem;\n        }\n\n        @media (min-width: 768px) {\n            .container {\n                grid-template-columns: 2fr 1fr;\n            }\n        }\n\n        .tool-section, .info-section {\n            background-color: var(--text-light);\n            padding: 2rem;\n            border-radius: 8px;\n            box-shadow: 0 2px 10px var(--shadow-color);\n        }\n\n        .tool-section h2, .info-section h3 {\n            color: var(--primary-green);\n            margin-top: 0;\n            font-size: 1.8rem;\n            border-bottom: 2px solid var(--border-color);\n            padding-bottom: 0.5rem;\n            margin-bottom: 1.5rem;\n        }\n\n        form label {\n            display: block;\n            margin-bottom: 0.5rem;\n            font-weight: bold;\n            color: var(--text-dark);\n        }\n\n        form select, form input[type=\"number\"] {\n            width: calc(100% - 20px);\n            padding: 10px;\n            margin-bottom: 1.5rem;\n            border: 1px solid var(--border-color);\n            border-radius: 4px;\n            box-sizing: border-box;\n            font-size: 1rem;\n        }\n\n        form button {\n            background-color: var(--primary-green);\n            color: var(--text-light);\n            padding: 12px 25px;\n            border: none;\n            border-radius: 5px;\n            cursor: pointer;\n            font-size: 1.1rem;\n            font-weight: bold;\n            transition: background-color 0.3s ease;\n        }\n\n        form button:hover {\n            background-color: #33B249;\n        }\n\n        #tool-result {\n            margin-top: 2rem;\n            padding: 1.5rem;\n            background-color: #e9f5e9;\n            border: 1px solid var(--border-color);\n            border-radius: 8px;\n            font-size: 1.1rem;\n            color: var(--text-dark);\n        }\n\n        #tool-result h4 {\n            color: var(--primary-green);\n            margin-top: 0;\n        }\n\n        .info-section {\n            background-color: #f9fdf9;\n            border-left: 5px solid var(--primary-green);\n        }\n\n        .info-section ul {\n            list-style: none;\n            padding: 0;\n        }\n\n        .info-section li {\n            margin-bottom: 0.8rem;\n            padding-left: 1.5rem;\n            position: relative;\n        }\n\n        .info-section li::before {\n            content: '🌿';\n            position: absolute;\n            left: 0;\n            color: var(--primary-green);\n        }\n\n        .call-to-action {\n            text-align: center;\n            margin: 3rem 0;\n            padding: 2rem;\n            background: linear-gradient(45deg, #CCE6CC 0%, #E0F2E0 100%);\n            border-radius: 8px;\n            box-shadow: 0 2px 8px var(--shadow-color);\n            width: 90%;\n            max-width: 800px;\n        }\n\n        .call-to-action h3 {\n            color: var(--primary-green);\n            font-size: 2rem;\n            margin-bottom: 1rem;\n        }\n\n        .call-to-action p {\n            font-size: 1.1rem;\n            margin-bottom: 2rem;\n        }\n\n        .call-to-action button {\n            background-color: var(--secondary-yellow);\n            color: var(--text-dark);\n            padding: 15px 30px;\n            border: none;\n            border-radius: 5px;\n            cursor: pointer;\n            font-size: 1.2rem;\n            font-weight: bold;\n            transition: background-color 0.3s ease;\n        }\n\n        .call-to-action button:hover {\n            background-color: #FFEA00;\n        }\n\n        footer {\n            width: 100%;\n            background-color: var(--text-dark);\n            color: var(--text-light);\n            padding: 2rem 0;\n            text-align: center;\n            margin-top: 3rem;\n        }\n\n        .seo-section {\n            width: 90%;\n            max-width: 1000px;\n            margin: 2rem auto;\n            padding: 1.5rem;\n            background-color: #f0f0f0;\n            border-radius: 8px;\n            border: 1px solid #ddd;\n            font-size: 0.9rem;\n            color: #555;\n        }\n\n        .seo-section h3 {\n            color: var(--primary-green);\n            font-size: 1.4rem;\n            margin-bottom: 1rem;\n        }\n    </style>\n    <meta name=\"robots\" content=\"index, follow\">\n    <link rel=\"canonical\" href=\"https://simulateur-d-impact-energetique-d-equipements-d-42d84224.onrender.com\">\n    <meta property=\"og:title\" content=\"Simulateur d&#x27;Impact Énergétique d&#x27;Équipements Domestiques\">\n    <meta property=\"og:description\" content=\"Calculez la consommation électrique estimée et l\">\n    <meta property=\"og:url\" content=\"https://simulateur-d-impact-energetique-d-equipements-d-42d84224.onrender.com\">\n    <meta property=\"og:type\" content=\"website\">\n    <script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"WebApplication\", \"name\": \"Simulateur d'Impact Énergétique d'Équipements Domestiques\", \"description\": \"Calculez la consommation électrique estimée et l\", \"url\": \"https://simulateur-d-impact-energetique-d-equipements-d-42d84224.onrender.com\", \"applicationCategory\": \"UtilityApplication\", \"operatingSystem\": \"Web Browser\"}</script>\n</head>\n<body data-site-slug=\"simulateur-d-impact-energetique-d-equipements-d-42d84224\" data-runtime-mode=\"energy_score_calculator\">\n    <header>\n        <h1>Simulateur d'Impact Énergétique Domestique</h1>\n        <p>Estimez la consommation électrique et l'empreinte carbone de vos appareils pour des choix plus verts et économes. Agissez pour un futur durable, dès aujourd'hui.</p>\n    </header>\n\n    <div class=\"container\">\n        <div class=\"tool-section\">\n            <h2>Votre Bilan Énergétique Personnalisé</h2>\n            <form id=\"tool-form\">\n                <label for=\"device\">Sélectionnez votre appareil :</label>\n                <select id=\"device\" name=\"device\">\n                    <option value=\"frigo\">Réfrigérateur (150W)</option>\n                    <option value=\"lave-linge\">Lave-linge (2000W)</option>\n                    <option value=\"tele\">Télévision (100W)</option>\n                    <option value=\"ordinateur\">Ordinateur Portable (50W)</option>\n                    <option value=\"four\">Four Électrique (2500W)</option>\n                    <option value=\"micro-ondes\">Micro-ondes (1000W)</option>\n                    <option value=\"bouilloire\">Bouilloire (2200W)</option>\n                    <option value=\"seche-linge\">Sèche-linge (2500W)</option>\n                    <option value=\"lave-vaisselle\">Lave-vaisselle (1500W)</option>\n                    <option value=\"fer-a-repasser\">Fer à repasser (1800W)</option>\n                </select>\n\n                <label for=\"usage-hours\">Heures d'utilisation par jour :</label>\n                <input type=\"number\" id=\"usage-hours\" name=\"usage-hours\" min=\"0\" max=\"24\" value=\"1\">\n\n                <label for=\"usage-days\">Jours d'utilisation par semaine :</label>\n                <input type=\"number\" id=\"usage-days\" name=\"usage-days\" min=\"0\" max=\"7\" value=\"7\">\n                \n                <button type=\"submit\" id=\"tool-submit\">Calculer mon impact</button>\n            </form>\n\n            <div id=\"tool-result\">\n                <h4>Vos Résultats :</h4>\n                <p>Sélectionnez un appareil et entrez vos données pour estimer sa consommation.</p>\n            </div>\n        </div>\n\n        <div class=\"info-section\">\n            <h3>Pourquoi calculer ?</h3>\n            <p>Comprendre la consommation de vos appareils est le premier pas vers une gestion énergétique plus intelligente.</p>\n            <ul>\n                <li>🌿 Réduisez vos factures d'électricité.</li>\n                <li>🌿 Diminuez votre empreinte carbone.</li>\n                <li>🌿 Identifiez les appareils énergivores.</li>\n                <li>🌿 Prenez des décisions d'achat éclairées.</li>\n                <li>🌿 Contribuez à un avenir plus vert.</li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"call-to-action\">\n        <h3>Prêt à optimiser votre consommation ?</h3>\n        <p>Chaque petit geste compte. Découvrez comment des ajustements simples peuvent faire une grande différence pour votre portefeuille et la planète.</p>\n        <button data-affiliate-slot=\"premium-guide-cta\">Découvrir les Astuces Éco-Gestes</button>\n    </div>\n\n    <div class=\"seo-section\">\n        <h3>Recherches associées et informations complémentaires</h3>\n        <p>Vous cherchez à <strong>réduire votre facture d'électricité</strong> ou à mieux comprendre votre <strong>consommation énergétique domestique</strong> ? Notre simulateur vous aide à calculer précisément l'<strong>impact écologique de vos appareils électroménagers</strong>. Que ce soit pour un <strong>lave-linge économe</strong>, un <strong>réfrigérateur basse consommation</strong>, ou simplement estimer le <strong>coût de l'énergie</strong> de votre télévision, nous vous offrons des données claires pour faire des <strong>économies d'énergie</strong>. Apprenez à <strong>optimiser votre consommation électrique</strong> et à réduire votre <strong>empreinte carbone maison</strong> en France. Notre outil de <strong>calcul d'énergie</strong> est idéal pour les foyers soucieux de leur budget et de l'environnement, cherchant des solutions pour une <strong>maison plus verte</strong> et des <strong>appareils moins énergivores</strong>. Utilisez ce <strong>simulateur d'électricité</strong> pour des conseils pratiques sur la <strong>gestion énergétique</strong> et la <strong>sobriété énergétique</strong>.</p>\n    </div>\n\n    <footer>\n        <p>&copy; 2023 Simulateur Énergétique. Tous droits réservés.</p>\n    </footer>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const form = document.getElementById('tool-form');\n            const resultDiv = document.getElementById('tool-result');\n\n            const devicePower = {\n                \"frigo\": 150,\n                \"lave-linge\": 2000,\n                \"tele\": 100,\n                \"ordinateur\": 50,\n                \"four\": 2500,\n                \"micro-ondes\": 1000,\n                \"bouilloire\": 2200,\n                \"seche-linge\": 2500,\n                \"lave-vaisselle\": 1500,\n                \"fer-a-repasser\": 1800\n            };\n\n            const carbonIntensityFrance = 0.057; // kg CO2e / kWh (valeur indicative pour la France, peu carbonée)\n            const electricityCostFrance = 0.25; // € / kWh (valeur indicative pour la France)\n\n            form.addEventListener('submit', (event) => {\n                event.preventDefault();\n\n                const deviceSelect = document.getElementById('device');\n                const selectedDevice = deviceSelect.value;\n                const hoursPerDay = parseFloat(document.getElementById('usage-hours').value);\n                const daysPerWeek = parseFloat(document.getElementById('usage-days').value);\n\n                if (isNaN(hoursPerDay) || isNaN(daysPerWeek) || hoursPerDay < 0 || daysPerWeek < 0) {\n                    resultDiv.innerHTML = \"<h4>Erreur de saisie :</h4><p>Veuillez entrer des nombres valides pour les heures et les jours.</p>\";\n                    return;\n                }\n\n                const powerWatts = devicePower[selectedDevice];\n                const powerKw = powerWatts / 1000; // Convertir en kW\n\n                const usageHoursPerYear = hoursPerDay * daysPerWeek * (365 / 7); // Heures par an\n                const annualConsumptionKWh = powerKw * usageHoursPerYear;\n                const annualCost = annualConsumptionKWh * electricityCostFrance;\n                const annualCarbonImpactKg = annualConsumptionKWh * carbonIntensityFrance;\n\n                resultDiv.innerHTML = `\n                    <h4>Résultats pour votre ${deviceSelect.options[deviceSelect.selectedIndex].text} :</h4>\n                    <p><strong>Consommation annuelle estimée :</strong> ${annualConsumptionKWh.toFixed(2)} kWh</p>\n                    <p><strong>Coût annuel estimé :</strong> ${annualCost.toFixed(2)} €</p>\n                    <p><strong>Impact carbone annuel estimé :</strong> ${annualCarbonImpactKg.toFixed(2)} kg de CO2e</p>\n                    <p class=\"small-text\">Ces estimations sont basées sur une puissance moyenne de l'appareil et les tarifs indicatifs de l'électricité en France.</p>\n                `;\n            });\n        });\n    </script>\n<div id=\"qa-smoke-result\" hidden></div>\n<script id=\"farmbuilder-affiliate-helper\">\n(function () {\n  window.__UTILITY_AFFILIATE_MAP = window.__UTILITY_AFFILIATE_MAP || {};\n  document.addEventListener(\"click\", function (event) {\n    const target = event.target.closest(\"[data-affiliate-slot]\");\n    if (!target) return;\n    const slot = target.getAttribute(\"data-affiliate-slot\");\n    const href = window.__UTILITY_AFFILIATE_MAP[slot];\n    if (!href) return;\n    if (target.tagName && target.tagName.toLowerCase() === \"a\") {\n      target.setAttribute(\"href\", href);\n      target.setAttribute(\"rel\", \"nofollow sponsored noopener noreferrer\");\n      return;\n    }\n    event.preventDefault();\n    window.open(href, \"_blank\", \"noopener\");\n  }, true);\n})();\n</script>\n<script id=\"farmbuilder-functional-qa\">\n(function () {\n  function marker() {\n    let node = document.getElementById(\"qa-smoke-result\");\n    if (node) return node;\n    node = document.createElement(\"div\");\n    node.id = \"qa-smoke-result\";\n    node.hidden = true;\n    document.body.appendChild(node);\n    return node;\n  }\n\n  let qaFinished = false;\n  let qaWatchdog = null;\n\n  function normalize(text) {\n    return String(text || \"\").replace(/\\s+/g, \" \").trim();\n  }\n\n  function findForm() {\n    return document.getElementById(\"tool-form\") || document.querySelector(\"form\");\n  }\n\n  function findResult() {\n    return (\n      document.getElementById(\"tool-result\") ||\n      document.querySelector(\"[data-result]\") ||\n      document.querySelector(\".tool-result, .result-card, .result, .results, .output, .preview, .diagnostic, .analysis\")\n    );\n  }\n\n  function primaryAction(form) {\n    if (!form) return null;\n    return (\n      document.getElementById(\"tool-submit\") ||\n      form.querySelector(\"#tool-submit\") ||\n      form.querySelector(\"[data-primary-action]\") ||\n      form.querySelector(\"button[type=submit]\") ||\n      form.querySelector(\"button\") ||\n      form.querySelector(\"input[type=submit]\")\n    );\n  }\n\n  function resultSignature(node) {\n    if (!node) return \"\";\n    const text = normalize(node.textContent);\n    const html = normalize(node.innerHTML).slice(0, 600);\n    return `${text}||${html}`;\n  }\n\n  function resultHeadline(node) {\n    if (!node) return \"\";\n    const heading = node.querySelector(\"h1, h2, h3, strong, b\");\n    return normalize(heading ? heading.textContent : \"\");\n  }\n\n  function sampleText(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"} ${field.placeholder || \"\"}`.toLowerCase();\n    if (/email/.test(key)) return \"bonjour@example.com\";\n    if (/url|site|website|lien/.test(key)) return \"https://example.com/offre-solaire\";\n    if (/phone|tel|mobile/.test(key)) return \"0612345678\";\n    if (/ville|city|localisation|location|region|departement|postal/.test(key)) return \"Paris\";\n    if (/orientation/.test(key)) return \"sud\";\n    if (/keyword|theme|topic|sujet|subject/.test(key)) return \"energie solaire domestique\";\n    if (/titre|title/.test(key)) return \"Simulateur solaire maison\";\n    if (/nom|name|project/.test(key)) return \"Projet Horizon\";\n    if (/description|notes|content|message/.test(key)) return \"Maison individuelle expo